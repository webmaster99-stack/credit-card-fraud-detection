# Copy to .env (git-ignored) and fill in. Never commit real values.
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-username>
MLFLOW_TRACKING_PASSWORD=<dagshub-access-token>

# Kaggle access token (kaggle.com/settings -> API). Used by fraud.data.ingest.
KAGGLE_API_TOKEN=<kaggle-access-token>

# Hugging Face Hub token, only needed for `fraud.serving.export --push`. Uses the cached
# `huggingface-cli login` session if unset.
HF_TOKEN=<hf-access-token>

# --- FastAPI service (api/), Phase 5 ---
# Postgres connection string (Neon in production; docker-compose.yml's `db` service locally).
DATABASE_URL=postgresql://fraud:fraud@localhost:5433/fraud
# Shared secret the frontend sends as the X-API-Key header. Any long random string.
API_KEY=<api-key>
# Comma-separated origins allowed to call the API from a browser (the Vercel deployment URL).
ALLOWED_ORIGINS=http://localhost:3000
# The HF Hub branch/tag the champion bundle is exported to (fraud.serving.export --alias champion).
MODEL_REVISION=champion
